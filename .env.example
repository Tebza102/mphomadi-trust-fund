# Copy to .env.local and fill in. .env* is gitignored except this example file.
#
# The VITE_ prefixed values below are Firebase *client* config. They are not
# secrets — they ship in the JS bundle and are visible to anyone. What protects
# your data is Firestore security rules plus App Check, never the obscurity of
# these values. They live here for environment separation, not secrecy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key). Public by design, same as above.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local only, for App Check during development. Generated in the Firebase
# console. Treat as a secret — it bypasses App Check enforcement.
VITE_APPCHECK_DEBUG_TOKEN=

# ---------------------------------------------------------------------------
# NOT for the client bundle. Used only by scripts/bootstrap-admin.mjs.
# This IS a real secret: it grants full Admin SDK access and bypasses every
# security rule in firestore.rules. Never commit the key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json
