# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
.vite/

# Secrets — NEVER commit these.
# A leaked service-account key grants full Admin SDK access to the Firebase
# project, which bypasses every Firestore security rule in this repo.
.env
.env.*
!.env.example
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
.runtimeconfig.json

# Firebase local state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Emulator data
emulator-data/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
