# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
.vite/

# Secrets — NEVER commit these.
# A leaked service-account key grants full Admin SDK access to the Firebase
# project, which bypasses every Firestore security rule in this repo.
.env
.env.*
.env.local
!.env.example
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json
.runtimeconfig.json

# Firebase local state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Emulator data
emulator-data/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local AI/dev-tool working state — never ship these as product source.
.claude/
.codex-review/

# Vercel CLI local link state (project/org ids, pulled env, OIDC token).
.vercel
# NOTE: .env rules live above, before the !.env.example negation. Do not add a
# bare `.env*` down here — it re-ignores the tracked example file.
